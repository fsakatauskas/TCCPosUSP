<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="pt-BR">
  <info>
    <title>Normas institucionais USP/ESALQ (autor-data)</title>
    <id>http://localhost/normas-usp-esalq</id>
    <updated>2026-11-03T00:00:00+00:00</updated>
    <category citation-format="author-date"/>
  </info>

  <macro name="autor">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; " delimiter-precedes-last="never"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="autor-curto">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; "/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="ano">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="fonte">
    <group delimiter=", ">
      <text variable="container-title"/>
      <text variable="publisher"/>
      <text variable="genre"/>
      <text variable="number"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="autor-curto"/>
        <text macro="ano"/>
      </group>
    </layout>
  </citation>

  <bibliography entry-spacing="1">
    <sort>
      <key macro="autor"/>
      <key macro="ano"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="autor"/>
        <text macro="ano"/>
        <text variable="title"/>
        <text macro="fonte"/>
        <text variable="URL"/>
        <text variable="DOI"/>
      </group>
    </layout>
  </bibliography>
</style>
