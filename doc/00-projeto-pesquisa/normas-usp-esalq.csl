<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="pt-BR">
  <info>
    <title>Normas institucionais USP/ESALQ (autor-data)</title>
    <id>http://localhost/normas-usp-esalq</id>
    <updated>2026-11-03T00:00:00+00:00</updated>
    <category citation-format="author-date"/>
  </info>

  <macro name="autor">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter="; " delimiter-precedes-last="never"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="autor-curto">
    <names variable="author">
      <name form="short" et-al-min="3" et-al-use-first="1" delimiter="; "/>
      <et-al term="et-al" font-style="normal"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="ano">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="acesso">
    <group delimiter=" " suffix=".">
      <text value="Disponível em:"/>
      <text variable="URL"/>
    </group>
    <date variable="accessed" prefix=" Acesso em: " suffix="." delimiter=" ">
      <date-part name="day"/>
      <date-part name="month" form="short" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="fonte">
    <group delimiter=". ">
      <text variable="genre"/>
      <group delimiter=", ">
        <text variable="container-title"/>
        <text variable="publisher"/>
        <text variable="number"/>
        <text variable="note"/>
        <text variable="publisher-place"/>
      </group>
      <text variable="DOI"/>
    </group>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="autor-curto"/>
        <text macro="ano"/>
      </group>
    </layout>
  </citation>

  <bibliography entry-spacing="1">
    <sort>
      <key macro="autor"/>
      <key macro="ano"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="autor"/>
        <text macro="ano"/>
        <text variable="title"/>
        <text macro="fonte"/>
        <text macro="acesso"/>
      </group>
    </layout>
  </bibliography>
</style>
